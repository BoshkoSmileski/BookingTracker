{
  /* The browser suite and the scripts that stand it up.
   *
   * A third project rather than folding `e2e/` into tsconfig.app.json: these run
   * in Node with Playwright's globals, not in the browser with `vite/client`, so
   * they need `types: ["node"]` and no DOM lib of the app's kind. Referenced
   * from tsconfig.json so `npm run build` (`tsc -b`) typechecks them alongside
   * the app - the same reason the Vitest suite is typechecked, and it is what
   * makes a broken E2E helper a build failure rather than a runtime surprise
   * twenty seconds into a browser run.
   *
   * `allowJs` is for `e2e/support/env.mjs`, which is plain JavaScript because
   * `scripts/e2e-prepare.mjs` imports it from bare Node, before Playwright's TS
   * loader exists. Its exports are inferred rather than declared; that is the
   * price of the connection string having exactly one definition.
   */
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.e2e.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "skipLibCheck": true,

    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["e2e", "scripts", "playwright.config.ts", "vite.e2e.config.ts"]
}
