{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost\\SQLEXPRESS;Database=BookingTracker;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Jwt": {
    "Issuer": "BookingTracker.Api",
    "Audience": "BookingTracker.Client",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "RateLimiting": {
    "Authentication": { "PermitLimit": 5, "WindowSeconds": 60, "QueueLimit": 0 },
    "Booking": { "PermitLimit": 60, "WindowSeconds": 60, "QueueLimit": 0 }
  },
  "Email": {
    "UseSmtp": false,
    "Host": "",
    "Port": 587,
    "Username": "",
    "Password": "",
    "EnableSsl": true,
    "FromEmail": "noreply@bookingtracker.example",
    "FromName": "BookingTracker",
    "MaxRetries": 5,
    "RetryDelaySeconds": 60,
    "QueuePollIntervalSeconds": 15
  },
  "Reminders": {
    "SweepIntervalSeconds": 60,
    "BatchSize": 100,
    "GracePeriodMinutes": 60,
    "MaxReminderAgeHours": 24
  },
  "Frontend": {
    "BaseUrl": "http://localhost:5173"
  },
  "GoogleCalendar": {
    "ClientId": "",
    "ClientSecret": "",
    "RedirectUri": "http://localhost:5216/api/calendar/google/callback"
  }
}
