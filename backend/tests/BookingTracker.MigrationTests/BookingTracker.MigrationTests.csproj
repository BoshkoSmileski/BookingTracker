<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.*" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Same reference set, and the same reasoning, as BookingTracker.SqlServerTests:
      the Api project boots the real pipeline, and the reference to
      BookingTracker.IntegrationTests is what keeps this project small - the host,
      TestJwt, BookingFlow and the recording email/calendar doubles are reused
      rather than written a third time. Only the database differs.

      VSTest enumerates tests in the assembly under test only, so nothing in the
      referenced test projects runs twice because of this reference.
    -->
    <ProjectReference Include="..\..\src\BookingTracker.Api\BookingTracker.Api.csproj" />
    <ProjectReference Include="..\..\src\BookingTracker.Domain\BookingTracker.Domain.csproj" />
    <ProjectReference Include="..\..\src\BookingTracker.Application\BookingTracker.Application.csproj" />
    <ProjectReference Include="..\..\src\BookingTracker.Infrastructure\BookingTracker.Infrastructure.csproj" />
    <ProjectReference Include="..\BookingTracker.IntegrationTests\BookingTracker.IntegrationTests.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
